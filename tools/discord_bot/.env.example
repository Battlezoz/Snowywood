# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- Discord ---
# Bot token from https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_BOT_TOKEN=
# Your server (guild) ID. Optional but recommended: makes slash commands register instantly.
DISCORD_GUILD_ID=
# Channel IDs (enable Developer Mode in Discord, right-click a channel -> Copy ID)
ANNOUNCE_CHANNEL_ID=
OOC_CHANNEL_ID=
AHELP_CHANNEL_ID=

# --- Game (BYOND world topic) ---
GAME_HOST=127.0.0.1
GAME_PORT=1337
# Must match COMMS_KEY in config/comms.txt
GAME_COMMS_KEY=

# --- Inbound HTTP ingest (game -> bot) ---
BOT_INGEST_HOST=127.0.0.1
BOT_INGEST_PORT=5000
# Must match DISCORD_BOT_SECRET in config/secrets.txt. Generate: openssl rand -hex 32
BOT_INGEST_SECRET=

# --- Behaviour ---
PRESENCE_INTERVAL=60

# --- RAG /ask command (optional; needs the llm + embed compose services) ---
# Index built by rag_extract.py + rag_ingest.py, mounted at /app/data by run.sh.
RAG_DB=/app/data/rag.sqlite
LLM_URL=http://127.0.0.1:8089
EMBED_URL=http://127.0.0.1:8090
# Retrieval: chunks considered / minimum cosine similarity before refusing.
RAG_TOP_K=5
RAG_MIN_SCORE=0.45
# Per-user seconds between /ask uses.
ASK_COOLDOWN=15
# Questions allowed to wait behind a running answer before bouncing with "busy".
ASK_MAX_QUEUE=3
# Set false to hide connected player names from /ask (count only) if
# who-is-online knowledge is enabling metagaming.
ASK_PLAYER_NAMES=true
